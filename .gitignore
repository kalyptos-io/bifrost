.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
*.egg-info/
.env

# demo ui (sveltekit) build output + deps
ui/node_modules/
ui/build/
ui/.svelte-kit/

# multi-gb baseline dumps, too large for git; regenerable via `bifrost-sync export`
train/data/baseline_*.jsonl

# bifrost-sync work-dir: resumable per-entity zips + dlt load state
.sync-work/

# regenerable from train/gen (over the exported baseline)
train/data/synth/

# segmenter artifact: onnx + meta tracked (ships in image); rest regenerable from train/model
train/data/artifacts/*
!train/data/artifacts/segmenter.onnx
!train/data/artifacts/segmenter.meta.json
