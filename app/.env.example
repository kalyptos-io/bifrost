# copy to .env and adjust. settings are read with the BIFROST_ prefix.
BIFROST_DATABASE_DSN=postgresql://bifrost:bifrost@localhost:5432/bifrost
# absolute path to the trained segmenter dir (host runs only; the image bakes its own at /models/segmenter)
BIFROST_SEGMENTER=/abs/path/to/repo/train/data/artifacts
# optional response cache (dragonfly/redis protocol); unset to disable (fail-open)
BIFROST_CACHE_URL=redis://localhost:6379/0
# datafordeler oauth client-credentials for bifrost-sync (host run autoloads this; compose sync profile interpolates it)
DATAFORDELER_CLIENT_ID=
DATAFORDELER_CLIENT_SECRET=
